# ===================================
# Articard 環境変数テンプレート
# このファイルをコピーして .env.local を作成してください
# cp .env.example .env.local
# ===================================

# ----- Database -----
DATABASE_URL="postgresql://articard:articard_dev_password@localhost:5432/articard"

# ----- Firebase Auth (Client) -----
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ----- Firebase Admin SDK (Server) -----
FIREBASE_ADMIN_PROJECT_ID=""
FIREBASE_ADMIN_CLIENT_EMAIL=""
FIREBASE_ADMIN_PRIVATE_KEY=""

# ----- OpenAI -----
OPENAI_API_KEY=""

# ----- FLUX API (BFL) -----
# 使用モデル: FLUX.2 Klein (common), FLUX.2 Pro (super_rare), FLUX 1.1 Pro (fallback)
BFL_API_KEY=""

# ----- Google Gemini API (Nano Banana用 - rare カード) -----
# https://aistudio.google.com/ で取得
GOOGLE_GEMINI_API_KEY=""

# ----- Google Cloud Storage -----
GCS_BUCKET_NAME=""
GOOGLE_CLOUD_PROJECT=""
GOOGLE_APPLICATION_CREDENTIALS=""

# ----- App Settings -----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ----- Mock Mode (for development) -----
MOCK_EXTERNAL_APIS="false"

# ----- Stripe (Payment) -----
# https://dashboard.stripe.com/test/apikeys で取得
STRIPE_SECRET_KEY="sk_test_xxxxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxx"
# Webhookシークレット（stripe listen で取得、または本番Webhookで設定）
STRIPE_WEBHOOK_SECRET=""

# Stripe Price IDs（商品カタログで作成した価格のID）
STRIPE_PRICE_PLUS="price_xxxxx"
STRIPE_PRICE_PREMIUM="price_xxxxx"